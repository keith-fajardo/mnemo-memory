{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnemo.local/schemas/viability-corpus-v1.schema.json",
  "title": "Mnemo viability corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_version", "provenance", "templates"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "corpus_version": {"type": "string", "minLength": 1},
    "provenance": {"type": "string", "minLength": 1},
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["template_id", "title", "category", "realistic", "challenge_tags", "task_prompt", "horizons", "events", "ground_truth"],
        "properties": {
          "template_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "realistic": {"type": "boolean"},
          "challenge_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "task_prompt": {"type": "string", "minLength": 1},
          "horizons": {
            "type": "object",
            "additionalProperties": false,
            "required": ["short", "medium", "long"],
            "properties": {
              "short": {"type": "integer", "minimum": 10, "maximum": 20},
              "medium": {"type": "integer", "minimum": 50, "maximum": 100},
              "long": {"type": "integer", "minimum": 200}
            }
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["event_key", "actor", "summary", "position"],
              "properties": {
                "event_key": {"type": "string", "minLength": 1},
                "actor": {"enum": ["user", "agent", "assistant", "tool"]},
                "summary": {"type": "string", "minLength": 1},
                "position": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          },
          "ground_truth": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required_active_facts", "required_constraints", "current_goals", "current_decisions", "superseded_decisions", "failed_approaches", "unresolved_questions", "next_actions", "protected_spans", "relevant_evidence", "critical_evidence", "irrelevant_or_obsolete", "expected_continuation", "critical_facts", "forbidden_facts", "retrieval_required"],
            "properties": {
              "required_active_facts": {"$ref": "#/$defs/stringArray"},
              "required_constraints": {"$ref": "#/$defs/stringArray"},
              "current_goals": {"$ref": "#/$defs/stringArray"},
              "current_decisions": {"$ref": "#/$defs/stringArray"},
              "superseded_decisions": {"$ref": "#/$defs/stringArray"},
              "failed_approaches": {"$ref": "#/$defs/stringArray"},
              "unresolved_questions": {"$ref": "#/$defs/stringArray"},
              "next_actions": {"$ref": "#/$defs/stringArray"},
              "protected_spans": {"$ref": "#/$defs/stringArray"},
              "relevant_evidence": {"$ref": "#/$defs/stringArray"},
              "critical_evidence": {"$ref": "#/$defs/stringArray"},
              "irrelevant_or_obsolete": {"$ref": "#/$defs/stringArray"},
              "expected_continuation": {"$ref": "#/$defs/stringArray"},
              "critical_facts": {"$ref": "#/$defs/stringArray"},
              "forbidden_facts": {"$ref": "#/$defs/stringArray"},
              "retrieval_required": {"$ref": "#/$defs/stringArray"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "stringArray": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
