# Non-secret example only. Keep the database password in the referenced 0600 file.
MNEMO_TEAM_DB_HOST=postgres.internal
MNEMO_TEAM_DB_PORT=5432
MNEMO_TEAM_DB_NAME=mnemo
MNEMO_TEAM_DB_USER=mnemo_runtime
MNEMO_TEAM_DB_PASSWORD_FILE=/run/secrets/mnemo-postgres-password
# Backup administration uses a separate non-superuser BYPASSRLS role and secret.
MNEMO_TEAM_BACKUP_DB_USER=mnemo_backup
MNEMO_TEAM_BACKUP_DB_PASSWORD_FILE=/run/secrets/mnemo-postgres-backup-password
# Optional; omit to use the operating system trust store.
MNEMO_TEAM_BACKUP_SSL_ROOT_CERT_FILE=/etc/mnemo/postgres-ca.pem
MNEMO_TEAM_OAUTH_PUBLIC_KEY_FILE=/etc/mnemo/oauth-public.pem
MNEMO_TEAM_OAUTH_ISSUER=https://identity.example.com
MNEMO_TEAM_RESOURCE_URL=https://memory.example.com/mcp
MNEMO_TEAM_OAUTH_ALGORITHM=RS256
MNEMO_TEAM_REQUIRED_SCOPES=mnemo:context
MNEMO_TEAM_HTTP_PORT=8766
MNEMO_TEAM_RATE_LIMIT_REQUESTS=120
MNEMO_TEAM_RATE_LIMIT_WINDOW_SECONDS=60
MNEMO_TEAM_RATE_LIMIT_IDENTITIES=10000
MNEMO_TEAM_DB_POOL_SIZE=16
